# Copy to .env and fill in. `netlify dev` loads .env automatically.
# Both Netlify functions (db.js, calendar.js) read these two vars.

# Supabase project URL — the BARE ORIGIN, with no trailing path.
#   Correct:   https://abcdefgh.supabase.co
#   Wrong:     https://abcdefgh.supabase.co/rest/v1/
# The dashboard (Integrations > Data API > Overview) displays the API URL
# WITH /rest/v1/ on the end, but db.js already appends that itself:
#   `${SUPABASE_URL}/rest/v1/${path}`
# Copying the displayed URL verbatim yields /rest/v1/rest/v1/... and 404s
# on every request.
SUPABASE_URL=

# Service-role key.
#   Dashboard > Settings > API Keys > "Legacy anon, service_role API keys" tab
#   (/settings/api-keys/legacy), then click Reveal on the service_role row.
#
# Bypasses RLS entirely — never commit it, never send it to the browser.
# Only the Netlify functions should ever see this value.
#
# Note: the legacy JWT keys (anon / service_role) are deprecated and are
# scheduled to stop working at the end of 2026. The replacement is a secret
# key (sb_secret_...) from the "Publishable and secret API keys" tab. db.js
# sends the key as both the `apikey` and `Authorization: Bearer` header,
# which is the same shape the new secret keys use, so migrating should be a
# matter of swapping the value here.
SUPABASE_SERVICE_KEY=

# Anthropic API key, used by netlify/functions/generate-schedule.js for
# AI-assisted schedule generation. Get one at https://console.anthropic.com
# (Settings > API keys). Without it that function returns an error; the rest
# of the app works normally.
#
# Server-side only — the function reads it from the environment and sends it
# as the x-api-key header. Never expose it to the browser.
ANTHROPIC_API_KEY=
