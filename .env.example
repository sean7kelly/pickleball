# Copy to .env and fill in. `netlify dev` loads .env automatically.
# Both functions (db.js, calendar.js) read these.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Service-role key (Supabase dashboard > Project Settings > API).
# Bypasses RLS — never commit this, never expose it to the browser.
SUPABASE_SERVICE_KEY=
